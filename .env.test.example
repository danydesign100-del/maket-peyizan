# Test version: copy to .env.test.local (never committed) and fill in with the
# SEPARATE test project (Supabase > Project Settings > API). See docs/TEST_VERSION.md.
VITE_SUPABASE_URL=https://your-test-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-test-publishable-key
VITE_USE_LOCAL_DB=false

# Used only by `npm run test-version:db` to apply the migrations (Supabase > Connect >
# Session pooler). It contains the database password: keep it in this file only.
SUPABASE_TEST_DB_URL=postgresql://postgres.your-test-project-ref:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
