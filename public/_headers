# The service worker and the page must always be checked for updates;
# hashed build assets never change and can be cached for a year.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
